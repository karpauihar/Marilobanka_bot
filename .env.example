# Telegram (обязательно для запуска)
TOKEN=

# Закрытый канал. Бот должен быть его администратором с правом создавать ссылки.
ACCESS_CHAT_ID=
ACCESS_CHANNEL_URL=

# Готовое приветственное сообщение, которое бот копирует при /start.
WELCOME_CHAT_ID=
WELCOME_MESSAGE_ID=

# Готовое сообщение с офертой. Если копирование не сработает, бот отправит PDF.
OFFER_CHAT_ID=
OFFER_MESSAGE_ID=

# Robokassa. До подключения оставьте значения пустыми.
MERCHANT_LOGIN=
PASS_1=
PASS_2=
PASS_3=
PASS_TEST_1=
PASS_TEST_2=
SERVER_URL=
URL_PREFIX=/bots/marilobanka
COST=1499
ROBOKASSA_TEST=0

# Для «Робочеков СМЗ» Receipt передаёт номенклатуру, а активная интеграция
# Robokassa с «Мой налог» регистрирует доход НПД. Значение sno не передаётся.
FISCALIZATION_MODE=receipt
RECEIPT_SNO=
RECEIPT_TAX=none
RECEIPT_PAYMENT_METHOD=full_payment
RECEIPT_PAYMENT_OBJECT=service
RECEIPT_ITEM_NAME=Гайд «Домашний уход за стопами»

# Необязательные настройки
SUPPORT_URL=
OFFER_FILE_PATH=../docs/public_offer.pdf
DATABASE_PATH=bot.db
LOG_PATH=logs/app.log
DELIVERY_RETRY_SECONDS=15
LOG_LEVEL=INFO
