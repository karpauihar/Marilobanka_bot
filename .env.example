# Telegram (обязательно для запуска)
TOKEN=

# Закрытый канал. Бот должен быть его администратором с правом создавать ссылки.
ACCESS_CHAT_ID=

# Готовое приветственное сообщение, которое бот копирует при /start.
WELCOME_CHAT_ID=
WELCOME_MESSAGE_ID=

# Robokassa. До подключения оставьте значения пустыми.
MERCHANT_LOGIN=
PASS_1=
PASS_2=
PASS_3=
PASS_TEST_1=
PASS_TEST_2=
SERVER_URL=
URL_PREFIX=/bots/marilobanka
COST=
ROBOKASSA_TEST=0

# Фискализация: npd для интеграции Robokassa с «Мой налог» или receipt
# для передачи номенклатуры онлайн-кассе/«Робочекам».
FISCALIZATION_MODE=
RECEIPT_SNO=
RECEIPT_TAX=
RECEIPT_PAYMENT_METHOD=
RECEIPT_PAYMENT_OBJECT=
RECEIPT_ITEM_NAME=

# Необязательные настройки
SUPPORT_URL=
OFFER_FILE_PATH=
DATABASE_PATH=bot.db
LOG_PATH=logs/app.log
DELIVERY_RETRY_SECONDS=15
LOG_LEVEL=INFO
